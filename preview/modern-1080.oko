# footer
text 48 1006 "RAIL: T TACTICAL - E ENGINEERING - S SCIENCE (SAME KEY RETURNS) - A ALERT - F FOCUS - 1-4 RUN - O BANNER - Q QUIT" 2 #5f7186
text 1560 1006 "OKO // DISPLAY LIST" 2 #5f7186

on key t toggle tactical
on key e toggle engineering
on key s toggle science
on key a toggle alert
on key f focus bridge
on key 1 run bridge "uname -a"
on key 2 run bridge "ps -o pid,comm,time | head -16"
on key 3 run bridge "df -h"
on key 4 run bridge "ls -1 ~/workspace | head -14"
on key o run bridge "uname -a && echo && uptime && echo && df -h / | tail -1 && grep -E 'MemTotal|MemFree' /proc/meminfo"
on key q quit
